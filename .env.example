# 이 파일을 .env 로 복사한 뒤 각자 발급받은 키를 채우세요. (.env 는 커밋되지 않습니다)

# 한국관광공사 TourAPI 4.0 — https://www.data.go.kr 에서 발급 (일반 인증키 / Decoding)
VITE_TOUR_API_KEY=
# 브라우저 CORS 우회용 자체 프록시 (예: https://api.내도메인.com/tour?url= ) — 비워두면 직접 호출
VITE_TOUR_PROXY=

# Kakao Developers — https://developers.kakao.com 내 애플리케이션 > 앱 키
VITE_KAKAO_JS_KEY=
VITE_KAKAO_REST_KEY=
VITE_KAKAO_NATIVE_KEY=
VITE_KAKAO_PROXY=

# GitHub Pages 배포 시에만 사용 (예: /daehanminguk-burumarble/)
VITE_BASE=/
